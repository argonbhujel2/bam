# Copy this file to .env  (same folder as run.py)
#   copy .env.example .env
# NEVER commit .env

SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=1

DATABASE_URL=sqlite:///bamstudio.db

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MailerSend / SMTP
MAIL_SERVER=smtp.mailersend.net
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=info@argan.com.np
# Where form notifications are delivered (optional)
MAIL_NOTIFY_TO=info@argan.com.np

ADMIN_SETUP_SECRET=change-this-setup-secret

SITE_URL=http://127.0.0.1:5000
